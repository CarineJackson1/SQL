-- ========================================
-- Netflix Database Analysis
-- ========================================
-- This project utilized data from the Netflix database
-- to analyze content, directors, and release patterns
-- ========================================


-- ========================================
-- Database Schema
-- ========================================

CREATE TABLE netflix_titles_info (
    "show_id" VARCHAR(5), 
    "type" VARCHAR(7), 
    "title" VARCHAR(58), 
    "country" VARCHAR(74), 
    "date_added" TIMESTAMP, 
    "release_year" INT, 
    "rating" VARCHAR(5), 
    "duration" VARCHAR(9), 
    "listed_in" VARCHAR(74)
);

CREATE TABLE netflix_people (
    "show_id" VARCHAR(5), 
    "director" VARCHAR(54), 
    "cast" VARCHAR(532)
);

-- [Sample data INSERT statements omitted for brevity]


-- ========================================
-- 1. Initial Data Exploration
-- ========================================
-- Join tables to see the complete dataset

SELECT 
    people.show_id,
    people.director,
    titles.title,
    titles.type
FROM "netflix_people" people
LEFT JOIN "netflix_titles_info" titles
    ON people.show_id = titles.show_id;


-- ========================================
-- 2. Movie Count
-- ========================================
-- Question: How many movie titles are in the database? 
-- (movies only, not TV shows)

SELECT COUNT(*) AS movie_count
FROM "netflix_titles_info"
WHERE type = 'Movie';


-- ========================================
-- 3. Most Recent Content Added
-- ========================================
-- Question: When was the most recent batch of TV shows 
-- and/or movies added to the database?

SELECT MAX(DATE(date_added)) AS most_recent_date
FROM "netflix_titles_info";


-- ========================================
-- 4. Alphabetical Content List
-- ========================================
-- Question: List all movies and TV shows in 
-- alphabetical order.

SELECT title
FROM "netflix_titles_info"
ORDER BY title ASC;


-- ========================================
-- 5. Director Lookup
-- ========================================
-- Question: Who was the director for the movie 
-- "The Starling"?

SELECT director
FROM "netflix_titles_info" titles
LEFT JOIN "netflix_people" people
    ON titles.show_id = people.show_id
WHERE titles.title = 'The Starling';


-- ========================================
-- 6. Oldest Movie
-- ========================================
-- Question: What is the oldest movie in the database 
-- and what year was it made?

SELECT 
    title,
    release_year
FROM "netflix_titles_info"
WHERE type = 'Movie'
ORDER BY release_year ASC
LIMIT 1;